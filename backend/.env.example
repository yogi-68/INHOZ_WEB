# Environment Configuration

# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inhoz?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AWS S3
S3_BUCKET=inhoz-storage
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Twilio (OTP)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Device Authentication
DEVICE_API_KEYS=device-key-1,device-key-2,device-key-3

# MQTT (optional)
MQTT_URI=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8082

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
DEVICE_RATE_LIMIT_MAX=1000

# Logging
LOG_LEVEL=info

# Frontend URLs (for emails)
WEB_APP_URL=http://localhost:5173
MOBILE_APP_URL=http://localhost:8082
