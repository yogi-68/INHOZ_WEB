import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { FaUsers, FaUserMd, FaBed, FaExclamationTriangle, FaMoneyBillWave, FaPlus, FaTrash, FaEdit, FaSearch } from 'react-icons/fa';
import apiClient from '../utils/api';
import { getSocket, initializeSocket } from '../utils/socket';

const StatCard = ({ icon: Icon, title, value, color, onClick }) => (
  <div 
    className={`bg-white p-6 rounded-lg shadow-md border-l-4 ${color} cursor-pointer hover:shadow-lg transition-shadow`}
    onClick={onClick}
  >
    <div className="flex items-center">
      <Icon className={`text-4xl mr-4 ${color.replace('border', 'text')}`} />
      <div>
        <h3 className="text-xl font-semibold text-gray-600">{title}</h3>
        <p className="text-3xl font-bold">{value}</p>
      </div>
    </div>
  </div>
);

const DoctorManagement = ({ doctors, onCreateDoctor, onDeleteDoctor }) => {
  const [showModal, setShowModal] = useState(false);
  const [newDoctor, setNewDoctor] = useState({
    email: '',
    password: '',
    firstName: '',
    lastName: '',
    specialization: '',
    phone: '',
  });
  const [searchTerm, setSearchTerm] = useState('');

  const handleSubmit = async (e) => {
    e.preventDefault();
    await onCreateDoctor(newDoctor);
    setShowModal(false);
    setNewDoctor({ email: '', password: '', firstName: '', lastName: '', specialization: '', phone: '' });
  };

  const filteredDoctors = doctors.filter(doc => 
    doc.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
    doc.email.toLowerCase().includes(searchTerm.toLowerCase()) ||
    doc.specialization.toLowerCase().includes(searchTerm.toLowerCase())
  );

  return (
    <div className="bg-white p-6 rounded-lg shadow-md mt-6">
      <div className="flex justify-between items-center mb-4">
        <h3 className="text-2xl font-semibold">Doctor Management</h3>
        <button
          onClick={() => setShowModal(true)}
          className="bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded inline-flex items-center transition duration-300"
        >
          <FaPlus className="mr-2" />
          Add Doctor
        </button>
      </div>

      <div className="mb-4">
        <div className="relative">
          <FaSearch className="absolute left-3 top-3 text-gray-400" />
          <input
            type="text"
            placeholder="Search doctors..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="w-full pl-10 pr-4 py-2 border rounded-lg focus:outline-none focus:border-blue-500"
          />
        </div>
      </div>

      <div className="overflow-x-auto">
        <table className="min-w-full">
          <thead>
            <tr className="bg-blue-500 text-white text-lg leading-normal">
              <th className="py-3 px-6 text-left">Name</th>
              <th className="py-3 px-6 text-left">Email</th>
              <th className="py-3 px-6 text-left">Specialization</th>
              <th className="py-3 px-6 text-left">Phone</th>
              <th className="py-3 px-6 text-left">Patients</th>
              <th className="py-3 px-6 text-left">Actions</th>
            </tr>
          </thead>
          <tbody className="text-gray-600 text-base">
            {filteredDoctors.map((doctor, index) => (
              <tr key={doctor.id} className={index % 2 === 0 ? 'bg-gray-100' : 'bg-white'}>
                <td className="py-3 px-6 text-left">{doctor.name}</td>
                <td className="py-3 px-6 text-left">{doctor.email}</td>
                <td className="py-3 px-6 text-left">{doctor.specialization}</td>
                <td className="py-3 px-6 text-left">{doctor.phone}</td>
                <td className="py-3 px-6 text-left">{doctor.patientCount}</td>
                <td className="py-3 px-6 text-left space-x-2">
                  <button
                    onClick={() => onDeleteDoctor(doctor.id)}
                    className="bg-red-500 hover:bg-red-600 text-white font-bold py-1 px-3 rounded inline-flex items-center transition duration-300"
                  >
                    <FaTrash className="mr-1" />
                    Delete
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {showModal && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center z-50">
          <div className="bg-white rounded-lg shadow-lg p-6 max-w-md w-full">
            <h2 className="text-2xl font-bold mb-4">Create New Doctor</h2>
            <form onSubmit={handleSubmit}>
              <div className="mb-4">
                <label className="block text-gray-700 mb-2">First Name</label>
                <input
                  type="text"
                  required
                  value={newDoctor.firstName}
                  onChange={(e) => setNewDoctor({ ...newDoctor, firstName: e.target.value })}
                  className="w-full px-4 py-2 border rounded-lg focus:outline-none focus:border-blue-500"
                />
              </div>
              <div className="mb-4">
                <label className="block text-gray-700 mb-2">Last Name</label>
                <input
                  type="text"
                  required
                  value={newDoctor.lastName}
                  onChange={(e) => setNewDoctor({ ...newDoctor, lastName: e.target.value })}
                  className="w-full px-4 py-2 border rounded-lg focus:outline-none focus:border-blue-500"
                />
              </div>
              <div className="mb-4">
                <label className="block text-gray-700 mb-2">Email</label>
                <input
                  type="email"
                  required
                  value={newDoctor.email}
                  onChange={(e) => setNewDoctor({ ...newDoctor, email: e.target.value })}
                  className="w-full px-4 py-2 border rounded-lg focus:outline-none focus:border-blue-500"
                />
              </div>
              <div className="mb-4">
                <label className="block text-gray-700 mb-2">Password</label>
                <input
                  type="password"
                  required
                  value={newDoctor.password}
                  onChange={(e) => setNewDoctor({ ...newDoctor, password: e.target.value })}
                  className="w-full px-4 py-2 border rounded-lg focus:outline-none focus:border-blue-500"
                />
              </div>
              <div className="mb-4">
                <label className="block text-gray-700 mb-2">Specialization</label>
                <input
                  type="text"
                  required
                  value={newDoctor.specialization}
                  onChange={(e) => setNewDoctor({ ...newDoctor, specialization: e.target.value })}
                  className="w-full px-4 py-2 border rounded-lg focus:outline-none focus:border-blue-500"
                />
              </div>
              <div className="mb-4">
                <label className="block text-gray-700 mb-2">Phone</label>
                <input
                  type="tel"
                  required
                  value={newDoctor.phone}
                  onChange={(e) => setNewDoctor({ ...newDoctor, phone: e.target.value })}
                  className="w-full px-4 py-2 border rounded-lg focus:outline-none focus:border-blue-500"
                />
              </div>
              <div className="flex justify-end space-x-2">
                <button
                  type="button"
                  onClick={() => setShowModal(false)}
                  className="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded"
                >
                  Create Doctor
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};

const PatientManagement = ({ patients }) => {
  const [searchTerm, setSearchTerm] = useState('');

  const filteredPatients = patients.filter(patient =>
    patient.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
    patient.hospitalId.toLowerCase().includes(searchTerm.toLowerCase())
  );

  return (
    <div className="bg-white p-6 rounded-lg shadow-md mt-6">
      <h3 className="text-2xl font-semibold mb-4">All Patients</h3>

      <div className="mb-4">
        <div className="relative">
          <FaSearch className="absolute left-3 top-3 text-gray-400" />
          <input
            type="text"
            placeholder="Search patients..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="w-full pl-10 pr-4 py-2 border rounded-lg focus:outline-none focus:border-blue-500"
          />
        </div>
      </div>

      <div className="overflow-x-auto">
        <table className="min-w-full">
          <thead>
            <tr className="bg-blue-500 text-white text-lg leading-normal">
              <th className="py-3 px-6 text-left">Name</th>
              <th className="py-3 px-6 text-left">Hospital ID</th>
              <th className="py-3 px-6 text-left">Room</th>
              <th className="py-3 px-6 text-left">Doctor</th>
              <th className="py-3 px-6 text-left">Status</th>
              <th className="py-3 px-6 text-left">Alerts</th>
            </tr>
          </thead>
          <tbody className="text-gray-600 text-base">
            {filteredPatients.map((patient, index) => (
              <tr key={patient.id} className={index % 2 === 0 ? 'bg-gray-100' : 'bg-white'}>
                <td className="py-3 px-6 text-left">{patient.name}</td>
                <td className="py-3 px-6 text-left">{patient.hospitalId}</td>
                <td className="py-3 px-6 text-left">{patient.room}</td>
                <td className="py-3 px-6 text-left">{patient.doctor}</td>
                <td className="py-3 px-6 text-left">
                  <span className={`bg-${patient.status === 'active' ? 'green' : 'gray'}-200 text-${patient.status === 'active' ? 'green' : 'gray'}-600 py-1 px-3 rounded-full text-sm`}>
                    {patient.status}
                  </span>
                </td>
                <td className="py-3 px-6 text-left">
                  {patient.unacknowledgedAlerts > 0 && (
                    <span className="bg-red-500 text-white py-1 px-3 rounded-full text-sm">
                      {patient.unacknowledgedAlerts}
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
};

const InvoiceManagement = ({ invoices }) => {
  return (
    <div className="bg-white p-6 rounded-lg shadow-md mt-6">
      <h3 className="text-2xl font-semibold mb-4">Recent Invoices</h3>
      <div className="overflow-x-auto">
        <table className="min-w-full">
          <thead>
            <tr className="bg-blue-500 text-white text-lg leading-normal">
              <th className="py-3 px-6 text-left">Invoice ID</th>
              <th className="py-3 px-6 text-left">Patient</th>
              <th className="py-3 px-6 text-left">Amount</th>
              <th className="py-3 px-6 text-left">Date</th>
              <th className="py-3 px-6 text-left">Status</th>
            </tr>
          </thead>
          <tbody className="text-gray-600 text-base">
            {invoices.map((invoice, index) => (
              <tr key={invoice.id} className={index % 2 === 0 ? 'bg-gray-100' : 'bg-white'}>
                <td className="py-3 px-6 text-left">{invoice.invoiceId}</td>
                <td className="py-3 px-6 text-left">{invoice.patientName}</td>
                <td className="py-3 px-6 text-left">${invoice.amount}</td>
                <td className="py-3 px-6 text-left">{invoice.date}</td>
                <td className="py-3 px-6 text-left">
                  <span className={`bg-${invoice.status === 'paid' ? 'green' : 'yellow'}-200 text-${invoice.status === 'paid' ? 'green' : 'yellow'}-600 py-1 px-3 rounded-full text-sm`}>
                    {invoice.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
};

const AdminDashboard = () => {
  const navigate = useNavigate();
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [activeView, setActiveView] = useState('overview'); // overview, doctors, patients, invoices

  const [stats, setStats] = useState({
    totalPatients: 0,
    totalDoctors: 0,
    activePatients: 0,
    criticalAlerts: 0,
    totalRevenue: 0,
  });

  const [doctors, setDoctors] = useState([]);
  const [patients, setPatients] = useState([]);
  const [invoices, setInvoices] = useState([]);

  useEffect(() => {
    const fetchDashboardData = async () => {
      try {
        setLoading(true);

        // Fetch admin dashboard stats
        const dashboardResponse = await apiClient.getAdminDashboard();
        const dashboardData = dashboardResponse?.data || {};

        setStats({
          totalPatients: dashboardData.totalPatients || 0,
          totalDoctors: dashboardData.totalDoctors || 0,
          activePatients: dashboardData.activePatients || 0,
          criticalAlerts: dashboardData.criticalAlerts || 0,
          totalRevenue: dashboardData.totalRevenue || 0,
        });

        // Fetch doctors list
        const doctorsResponse = await apiClient.getDoctors();
        const doctorsData = doctorsResponse?.data || [];
        setDoctors(doctorsData.map(doc => ({
          id: doc._id,
          name: `${doc.userId.profile.firstName} ${doc.userId.profile.lastName}`,
          email: doc.userId.email,
          specialization: doc.specialization || 'General',
          phone: doc.userId.profile.phone || 'N/A',
          patientCount: doc.patientCount || 0,
        })));

        // Fetch all patients
        const patientsResponse = await apiClient.getAdminPatients();
        const patientsData = patientsResponse?.data || [];
        setPatients(patientsData.map(patient => ({
          id: patient._id,
          name: `${patient.userId.profile.firstName} ${patient.userId.profile.lastName}`,
          hospitalId: patient.hospitalId,
          room: patient.roomNo,
          doctor: patient.doctorId?.userId?.profile ? 
            `${patient.doctorId.userId.profile.firstName} ${patient.doctorId.userId.profile.lastName}` : 
            'Unassigned',
          status: patient.status,
          unacknowledgedAlerts: patient.unacknowledgedAlerts || 0,
        })));

        // Fetch invoices
        const invoicesResponse = await apiClient.getInvoices();
        const invoicesData = invoicesResponse?.data || [];
        setInvoices(invoicesData.map(invoice => ({
          id: invoice._id,
          invoiceId: invoice.invoiceId,
          patientName: invoice.patientId?.userId?.profile ? 
            `${invoice.patientId.userId.profile.firstName} ${invoice.patientId.userId.profile.lastName}` : 
            'Unknown',
          amount: invoice.totalAmount,
          date: new Date(invoice.createdAt).toLocaleDateString(),
          status: invoice.status,
        })));

      } catch (err) {
        console.error('Error fetching admin dashboard data:', err);
        setError(err.message);
      } finally {
        setLoading(false);
      }
    };

    fetchDashboardData();
  }, []);

  // Setup Socket.IO for real-time updates
  useEffect(() => {
    const token = apiClient.getToken();
    if (!token) return;

    try {
      initializeSocket(token);
      const socket = getSocket();

      socket.on('alert:new', (alert) => {
        console.log('🚨 New critical alert:', alert);
        if (alert.severity === 'critical') {
          setStats(prev => ({ ...prev, criticalAlerts: prev.criticalAlerts + 1 }));
        }
      });

      return () => {
        socket.off('alert:new');
      };
    } catch (err) {
      console.error('Socket.IO setup error:', err);
    }
  }, []);

  const handleCreateDoctor = async (doctorData) => {
    try {
      await apiClient.createDoctor(doctorData);
      // Refresh doctors list
      const response = await apiClient.getDoctors();
      const doctorsData = response?.data || [];
      setDoctors(doctorsData.map(doc => ({
        id: doc._id,
        name: `${doc.userId.profile.firstName} ${doc.userId.profile.lastName}`,
        email: doc.userId.email,
        specialization: doc.specialization || 'General',
        phone: doc.userId.profile.phone || 'N/A',
        patientCount: doc.patientCount || 0,
      })));
      alert('Doctor created successfully!');
    } catch (err) {
      console.error('Error creating doctor:', err);
      alert('Failed to create doctor: ' + err.message);
    }
  };

  const handleDeleteDoctor = async (doctorId) => {
    if (!window.confirm('Are you sure you want to delete this doctor?')) return;

    try {
      await apiClient.deleteDoctor(doctorId);
      setDoctors(prev => prev.filter(doc => doc.id !== doctorId));
      alert('Doctor deleted successfully!');
    } catch (err) {
      console.error('Error deleting doctor:', err);
      alert('Failed to delete doctor: ' + err.message);
    }
  };

  if (loading) {
    return (
      <div className="p-6 flex justify-center items-center h-screen">
        <div className="text-center">
          <div className="animate-spin rounded-full h-16 w-16 border-b-2 border-blue-500 mx-auto mb-4"></div>
          <p className="text-xl text-gray-600">Loading admin dashboard...</p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="p-6">
        <div className="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <p className="font-bold">Error loading dashboard</p>
          <p>{error}</p>
        </div>
        <button 
          onClick={() => window.location.reload()}
          className="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded"
        >
          Retry
        </button>
      </div>
    );
  }

  return (
    <div className="p-6">
      <div className="flex justify-between items-center mb-6">
        <h2 className="text-3xl font-bold">Admin Dashboard</h2>
        <div className="space-x-2">
          <button
            onClick={() => setActiveView('overview')}
            className={`${activeView === 'overview' ? 'bg-blue-500' : 'bg-gray-300'} hover:bg-blue-600 text-white font-bold py-2 px-4 rounded transition duration-300`}
          >
            Overview
          </button>
          <button
            onClick={() => setActiveView('doctors')}
            className={`${activeView === 'doctors' ? 'bg-blue-500' : 'bg-gray-300'} hover:bg-blue-600 text-white font-bold py-2 px-4 rounded transition duration-300`}
          >
            Doctors
          </button>
          <button
            onClick={() => setActiveView('patients')}
            className={`${activeView === 'patients' ? 'bg-blue-500' : 'bg-gray-300'} hover:bg-blue-600 text-white font-bold py-2 px-4 rounded transition duration-300`}
          >
            Patients
          </button>
          <button
            onClick={() => setActiveView('invoices')}
            className={`${activeView === 'invoices' ? 'bg-blue-500' : 'bg-gray-300'} hover:bg-blue-600 text-white font-bold py-2 px-4 rounded transition duration-300`}
          >
            Invoices
          </button>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-5 gap-6 mb-6">
        <StatCard 
          icon={FaBed} 
          title="Total Patients" 
          value={stats.totalPatients} 
          color="border-blue-500"
          onClick={() => setActiveView('patients')}
        />
        <StatCard 
          icon={FaUserMd} 
          title="Total Doctors" 
          value={stats.totalDoctors} 
          color="border-green-500"
          onClick={() => setActiveView('doctors')}
        />
        <StatCard 
          icon={FaUsers} 
          title="Active Patients" 
          value={stats.activePatients} 
          color="border-purple-500"
          onClick={() => setActiveView('patients')}
        />
        <StatCard 
          icon={FaExclamationTriangle} 
          title="Critical Alerts" 
          value={stats.criticalAlerts} 
          color="border-red-500"
          onClick={() => setActiveView('patients')}
        />
        <StatCard 
          icon={FaMoneyBillWave} 
          title="Revenue" 
          value={`$${stats.totalRevenue.toLocaleString()}`} 
          color="border-yellow-500"
          onClick={() => setActiveView('invoices')}
        />
      </div>

      {activeView === 'doctors' && (
        <DoctorManagement 
          doctors={doctors} 
          onCreateDoctor={handleCreateDoctor}
          onDeleteDoctor={handleDeleteDoctor}
        />
      )}

      {activeView === 'patients' && (
        <PatientManagement patients={patients} />
      )}

      {activeView === 'invoices' && (
        <InvoiceManagement invoices={invoices} />
      )}

      {activeView === 'overview' && (
        <div className="bg-white p-6 rounded-lg shadow-md">
          <h3 className="text-2xl font-semibold mb-4">System Overview</h3>
          <p className="text-gray-600">
            Welcome to the INHOZ Admin Dashboard. Use the navigation above to manage doctors, patients, and invoices.
          </p>
          <div className="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
            <div className="p-4 bg-blue-50 rounded-lg">
              <h4 className="font-semibold text-blue-900 mb-2">Quick Actions</h4>
              <ul className="text-sm text-blue-700 space-y-2">
                <li>• Add new doctors to the system</li>
                <li>• Monitor patient assignments</li>
                <li>• Track financial transactions</li>
              </ul>
            </div>
            <div className="p-4 bg-green-50 rounded-lg">
              <h4 className="font-semibold text-green-900 mb-2">System Health</h4>
              <ul className="text-sm text-green-700 space-y-2">
                <li>• All systems operational</li>
                <li>• Real-time monitoring active</li>
                <li>• Database connected</li>
              </ul>
            </div>
            <div className="p-4 bg-purple-50 rounded-lg">
              <h4 className="font-semibold text-purple-900 mb-2">Recent Activity</h4>
              <ul className="text-sm text-purple-700 space-y-2">
                <li>• {stats.criticalAlerts} critical alerts today</li>
                <li>• {stats.activePatients} patients monitored</li>
                <li>• {stats.totalDoctors} doctors online</li>
              </ul>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default AdminDashboard;
